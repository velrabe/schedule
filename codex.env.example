# Copy to codex.env in repo root (gitignored). Codex can commit this file ONLY in private repo
# if Environment variables UI does not inject Secrets into the shell.
#
# Preferred order for the agent:
#   1) Codex → Environment variables (SCHEDULE_FUNCTIONS_URL + SCHEDULE_API_KEY)
#   2) SCHEDULE_TOKEN (generate locally once — see AGENTS.md)
#   3) This file on disk in /workspace/schedule/codex.env

SCHEDULE_FUNCTIONS_URL=https://YOUR-PROJECT-REF.functions.supabase.co

# Option A: dedicated agent key (set same value as Supabase Edge secret AGENT_API_KEY)
# SCHEDULE_API_KEY=

# Option B: app password (= APP_PASSWORD in Supabase)
# SCHEDULE_PASSWORD=

# Option C: long-lived JWT from local `node scripts/schedule-api.mjs login` → cat .schedule-token
# SCHEDULE_TOKEN=
