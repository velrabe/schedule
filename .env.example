# Copy to apps/web/.env.local for local dev. Don't commit real values.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key
VITE_FUNCTIONS_URL=https://YOUR-PROJECT-REF.functions.supabase.co

# For GitHub Pages deploy from a project repo (e.g. /schedule/),
# uncomment and set:
# VITE_BASE_PATH=/schedule/

# Codex / scripts (scripts/schedule-api.mjs) — same password as Supabase APP_PASSWORD
# SCHEDULE_FUNCTIONS_URL=https://YOUR-PROJECT-REF.functions.supabase.co
# SCHEDULE_PASSWORD=your-shared-password
